# Database Configuration
# Railway will automatically provide DATABASE_URL when you add a Postgres database
DATABASE_URL=postgresql://user:password@host:port/database

# Node Environment
NODE_ENV=production

# Optional: API URL for frontend (only needed in development)
# Leave empty in production - the frontend will use relative paths
VITE_API_URL=http://localhost:3000

# Feature Flags (build-time)
# Set to "true" to reveal the 2027 Season Memberships page, nav link, and
# homepage call-to-action. Leave unset or "false" to hide it on the live site.
# Changing this requires a rebuild/redeploy.
VITE_FEATURE_MEMBERSHIPS=false
